# Files never uploaded to Vercel (the site is built from src/ + public/ only).
# IMPORTANT: patterns are anchored with a leading "/" so they only match at the project root.
# (An unanchored "data/" would also remove src/data and src/modules/*/data that the build needs.)
/data/
/supabase/data/
/scripts/data/
/scripts/babel-autosync/chrome-profile/
/scripts/babel-autosync/node_modules/
# Same as .gitignore (a .vercelignore replaces it for the CLI)
node_modules
dist
dist-ssr
*.local
*.log
.env
.env.*
.vercel
/supabase/.temp
/supabase/.branches
_trial*.txt
_trial*.mjs
